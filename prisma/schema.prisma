// این فایل شکل جدول آگهی‌ها در دیتابیس را مشخص می‌کند.
// هر آگهی یک ردیف در جدول `Listing` (لیستینگ) است؛ همان فیلدهایی که قبلاً
// در فایل `data/listings.json` بودند، حالا ستون‌های این جدول‌اند.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Listing {
  // شناسه‌ی داخلی ردیف؛ فقط برای مرتب نگه داشتن جدول است.
  id           Int      @id @default(autoincrement())
  // شناسه‌ی یکتای آگهی در دیوار؛ مثل شماره‌ی پرونده‌ی یک فایل در بنگاه.
  token        String   @unique
  // تیتر آگهی، همان چیزی که در دیوار نوشته شده است.
  title        String
  // قیمت آگهی به همان صورت متنی که دیوار می‌دهد.
  priceText    String
  // محله‌ای که آگهی در آن است؛ مثل «مهران (سیدخندان)».
  district     String
  // دسته‌ی آگهی به زبان کد؛ مثل 'apartment-rent'.
  category     String
  // دسته‌ی آگهی به زبان آدم؛ مثل «رهن و اجاره آپارتمان».
  categoryLabel String
  // لینک باز کردن آگهی در دیوار.
  url          String
  // آیا آگهی مال یک شخص است یا آژانس؟ فقط آگهی‌های شخصی ذخیره می‌شوند.
  isPersonal   Boolean
  // آگهی از کجا آمده است؛ در نسخه‌ی اول فقط 'divar' است.
  source       String
  // تاریخی که آگهی را گرفتیم.
  fetchedAt    DateTime

  // بیشتر جست‌وجوها بر اساس محله است، پس روی محله فهرست می‌سازیم.
  @@index([district])
}
