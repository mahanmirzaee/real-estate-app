// این فایل شکل جدول آگهی‌ها در دیتابیس را مشخص می‌کند.
// هر آگهی یک ردیف در جدول `Listing` (لیستینگ) است؛ همان فیلدهایی که قبلاً
// در فایل `data/listings.json` بودند، حالا ستون‌های این جدول‌اند.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Listing {
  // شناسه‌ی داخلی ردیف؛ فقط برای مرتب نگه داشتن جدول است.
  id           Int      @id @default(autoincrement())
  // شناسه‌ی یکتای آگهی در دیوار؛ مثل شماره‌ی پرونده‌ی یک فایل در بنگاه.
  token        String   @unique
  // تیتر آگهی، همان چیزی که در دیوار نوشته شده است.
  title        String
  // قیمت آگهی به همان صورت متنی که دیوار می‌دهد.
  priceText    String
  // محله‌ای که آگهی در آن است؛ مثل «مهران (سیدخندان)».
  district     String
  // دسته‌ی آگهی به زبان کد؛ مثل 'apartment-rent'.
  category     String
  // دسته‌ی آگهی به زبان آدم؛ مثل «رهن و اجاره آپارتمان».
  categoryLabel String
  // لینک باز کردن آگهی در دیوار.
  url          String
  // آیا آگهی مال یک شخص است یا آژانس؟ فقط آگهی‌های شخصی ذخیره می‌شوند.
  isPersonal   Boolean
  // آگهی از کجا آمده است؛ 'divar' یا 'sheypoor'.
  source       String
  // تاریخی که آگهی را گرفتیم.
  fetchedAt    DateTime
  // نشانی عکس آگهی؛ اگر آگهی عکس نداشت، خالی می‌ماند و رابط کاربری جای عکس را خالی می‌گذارد.
  imageUrl     String?
  // رهن آگهی به تومان؛ فقط برای دسته‌های اجاره پر می‌شود. اگر قیمت خوانده نشد، خالی است.
  // `Float` (فلوت) است نه `Int` (اینت)، چون رهن بالای ۲٬۱۴۷٬۴۸۳٬۶۴۷ تومان در `Int` جا نمی‌شود.
  rahnAmount   Float?
  // اجاره‌ی ماهانه به تومان؛ برای «رهن کامل» صفر است، نه خالی.
  ejareAmount  Float?
  // متن کامل آگهی؛ برای دیوار از صفحه‌ی خود آگهی می‌آید، برای شیپور از جزئیاتش.
  // آگهی‌های قدیمی که موقع ذخیره متن نداشتند، این ستونشان خالی است.
  description  String?
  // عکس‌های آگهی؛ اگر منبع بیش از یک عکس داده باشد، همه اینجاست و کارت گالری می‌شود.
  // عکس اول همان `imageUrl` است؛ بقیه فقط اینجا هستند.
  imageUrls    Json?
  // متراژ آگهی به متر مربع؛ از تیتر یا متن درآورده می‌شود، مثل «۸۰ متری».
  // اگر متراژ خوانده نشد، خالی است و «متری» نشان داده نمی‌شود.
  areaSqm      Float?
  // قیمت فروش آگهی به تومان؛ فقط برای دسته‌های خرید پر می‌شود.
  // برای اجاره خالی است؛ آنجا رهن و اجاره را داریم.
  saleAmount   Float?
  // امکانات آگهی که از متن درآورده‌ایم؛ به شکل `JSON` (جیسون):
  // پارکینگ، انباری و آسانسور هر کدام درست/غلط/خالی‌اند
  // (خالی یعنی «از روی متن معلوم نشد») و `highlight` (هایلایت) یک ویژگی خوب از متن است.
  features     Json?
  // تاریخ انتشار آگهی از زبان خود منبع؛ برای دیوار از صفحه‌ی آگهی
  // («انتشار آگهی: ۲۲ آبان ۱۴۰۵») و برای شیپور از `addedAt` (ادد ات) جزئیاتش.
  // اگر منبع تاریخ نداد، خالی می‌ماند و `fetchedAt` (اولین دیده‌شدن) جای آن را می‌گیرد.
  publishedAt  DateTime?

  // بیشتر جست‌وجوها بر اساس محله است، پس روی محله فهرست می‌سازیم.
  @@index([district])
}

// کاربرهای برنامه؛ همان «کی می‌تواند وارد شود».
// ورود با کد ۶ رقمی است و کد همین‌جا خوانا ذخیره می‌شود
// تا ماهان بتواند آن را از دیتابیس (مثلاً `pgAdmin` — پی‌جی‌ادمین) بخواند.
// نقش (`role` — رول) دو مقدار دارد: `user` (یوزر) یعنی کاربر معمولی
// و `admin` (ادمین) یعنی مدیر؛ قسمت مدیر فعلاً خاموش است و فقط نقشش اینجاست
// تا بعداً روشنش کنیم.
model AppUser {
  // شناسه‌ی داخلی ردیف.
  id        Int      @id @default(autoincrement())
  // اسم کسی که وارد می‌شود؛ بالای صفحه همین اسم با خوش‌آمد نشان داده می‌شود.
  name      String
  // کد ۶ رقمی ورود؛ یکتاست و هرگز خودکار عوض نمی‌شود.
  code      String   @unique
  // نقش کاربر؛ `user` یا `admin`.
  role      String   @default("user")
  // وقتی کاربر ساخته شد.
  createdAt DateTime @default(now())
}

// دفتر رویدادهای خوانده‌نشده؛ همان «اوت‌باکس» (`Outbox`) جلسه‌ی سوم معماری.
// هر وقت آگهی تازه‌ای ذخیره می‌شود، یک ردیف هم اینجا نوشته می‌شود؛
// آگهی و رویدادش در یک تراکنش با هم نوشته می‌شوند، پس یا هر دو هستند یا هیچ‌کدام.
// کسی که اعلان می‌خواهد، فقط همین دفتر را می‌خواند و هیچ‌وقت آگهی تازه‌ای گم نمی‌شود.
model OutboxEvent {
  // شناسه‌ی داخلی ردیف.
  id          Int      @id @default(autoincrement())
  // نوع رویداد؛ فعلاً فقط 'listing.created' یعنی «آگهی تازه آمد».
  eventType   String
  // خود آگهی، به شکل `JSON` (جیسون)؛ همه‌ی فیلدهای آگهی اینجا هست.
  payload     Json
  // وقتی رویداد نوشته شد.
  createdAt   DateTime @default(now())
  // وقتی رویداد خوانده شد؛ تا وقتی خالی است یعنی هنوز خوانده نشده.
  processedAt DateTime?
}

// دفتر تنظیمات برنامه؛ هر تنظیم یک ردیف با کلید و مقدار متنی است.
// فعلاً فقط کلید `districts` (دیستریکتس) اینجا زندگی می‌کند: فهرست محله‌ها
// به شکل `JSON` (جیسون)؛ اگر ردیفی نبود، همان سه محله‌ی دفترچه‌ی ثابت برمی‌گردد.
model AppConfig {
  // کلید تنظیم؛ مثل 'districts'.
  key       String   @id
  // مقدار تنظیم؛ برای محله‌ها یک لیست `JSON` (جیسون) است.
  value     String
  // آخرین باری که عوض شد.
  updatedAt DateTime @updatedAt
}

// دفترچه‌ی مشتری‌ها؛ هر مشتری یک نفر است که دنبال فایل می‌گردد.
// وقتی آگهی تازه‌ای آمد، برنامه می‌پرسد به کدام مشتری می‌خورد و در چت وضعیت می‌گوید.
model Client {
  // شناسه‌ی داخلی ردیف.
  id            Int      @id @default(autoincrement())
  // اسم مشتری؛ مثلاً «آقای رضایی».
  name          String
  // دنبال اجاره است یا خرید؛ 'rent' یعنی اجاره، 'buy' یعنی خرید.
  kind          String
  // سقف ودیعه برای اجاره، سقف قیمت کل برای خرید؛ اگر خالی باشد یعنی سقفی ندارد.
  maxDeposit    Float?
  // سقف اجاره‌ی ماهانه؛ فقط برای اجاره معنی دارد.
  maxRent       Float?
  // محله‌ای که مشتری می‌خواهد؛ اگر خالی باشد یعنی هر محله‌ای.
  district      String?
  // این امکانات را می‌خواهد؟ درست یعنی «می‌خواهد»، غلط یعنی «فرقی نمی‌کند».
  wantsParking  Boolean  @default(false)
  wantsStorage  Boolean  @default(false)
  wantsElevator Boolean  @default(false)
  // نوع ملک؛ 'apartment' یعنی مسکونی، 'office' یعنی دفترکار، 'land' یعنی زمین.
  // اگر خالی باشد یعنی هر نوعی؛ در فرم مشتری انتخاب می‌شود.
  propertyKind  String?
  // یادداشت کوتاه ماهان درباره‌ی این مشتری؛ مثلاً «فقط طبقه‌ی اول».
  note          String?
  // وقتی مشتری ثبت شد.
  createdAt     DateTime @default(now())
}
